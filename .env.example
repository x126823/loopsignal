# Local development only. Copy to .env (gitignored). Never commit real secrets.

# Owner connection: used by Prisma migrations and test cleanup only.
DATABASE_URL="postgresql://loopsignal:loopsignal@localhost:5432/loopsignal?schema=public"
# Runtime connection: non-owner role without BYPASSRLS, so RLS always applies.
APP_DATABASE_URL="postgresql://loopsignal_app:loopsignal_app@localhost:5432/loopsignal?schema=public"
REDIS_URL="redis://localhost:6379"

# Encrypts message bodies and raw payloads. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# Dev login for synthetic users. Ignored (and rejected) when NODE_ENV=production.
AUTH_DEV_LOGIN="true"
# Optional Google OIDC (leave empty to disable).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LLM provider. "fake" (default) never contacts a model. "claude" uses the Anthropic API; the SDK reads its own
# credentials (ANTHROPIC_API_KEY, or `ant auth login`), which are never stored or validated here.
# Synthetic data only until the user authorizes real data (CLAUDE.md rule 7).
LLM_PROVIDER="fake"
LLM_MODEL="claude-opus-5-5"
LLM_EFFORT="medium"
LLM_DAILY_TOKEN_BUDGET="2000000"

# Gmail (Sprint 11). OFF by default. Synthetic/test mailboxes only until the user authorizes real data (CLAUDE.md rule 7).
# Create an OAuth client in a Google Cloud *test* project; the only scope requested is gmail.readonly. Never commit these.
GMAIL_ENABLED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APP_BASE_URL="http://localhost:3000"
GMAIL_BACKFILL_DAYS="7"
# Optional push (otherwise the worker polls every few minutes). All three are required together:
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUSH_AUDIENCE=""
GMAIL_PUSH_SERVICE_ACCOUNT=""

# Google Chat (Sprint 12). OFF by default. Synthetic/test spaces only until the user authorizes real data (CLAUDE.md rule 7).
# One product-wide Chat app (a service account), approved once by each customer's Workspace admin for chat.app.messages.readonly.
# Paste the whole key file as one line of JSON. Never commit it.
GOOGLE_CHAT_ENABLED="false"
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=""
GOOGLE_CHAT_BACKFILL_DAYS="7"
